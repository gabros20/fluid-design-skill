{
  "$schema": "./fluid.config.schema.json",
  "version": 2,
  "prefix": "fluid",
  "bands": {
    "phone": {
      "enabled": true
    },
    "tablet": {
      "enabled": true,
      "minWidth": 600
    },
    "landscape": {
      "enabled": true,
      "maxHeight": 500
    },
    "desktop": {
      "minWidth": 1024
    }
  },
  "roles": [
    "display",
    "copy"
  ],
  "ui": true,
  "zoom": true,
  "output": {
    "dir": "src/styles/fluid",
    "stack": "tailwind-v4",
    "base": true,
    "integration": "none"
  },
  "tailwind": {
    "breakpoints": "ladder",
    "variants": true,
    "utilities": {
      "negative": true,
      "logical": true,
      "basis": true,
      "scroll": true,
      "space": true,
      "rounded": true
    }
  },
  "aliases": false
}
